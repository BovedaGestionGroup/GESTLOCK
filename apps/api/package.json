{
  "name": "@gestor/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "db:push": "prisma db push --schema prisma/schema.prisma --skip-generate",
    "start": "node dist/index.js",
    "test": "prisma generate && prisma db push --skip-generate && vitest run"
  },
  "dependencies": {
    "@prisma/client": "5.4.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.0.1",
    "express": "4.21.2",
    "jsonwebtoken": "9.0.3",
    "otplib": "^13.4.1",
    "prisma": "5.4.1",
    "zod": "3.15.1",
    "@types/cookie-parser": "1.4.7",
    "@types/cors": "2.8.5",
    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^20.14.15",
    "typescript": "5.5.4"
  },
  "devDependencies": {
    "@types/supertest": "6.0.0",
    "supertest": "7.0.0",
    "tsx": "4.19.0",
    "vitest": "2.1.4"
  }
}
